# Copia este archivo como .env.vision-lab.local solo para desarrollo local.
# No uses .env.backend.local: pertenece a la configuracion anterior de OrbiNodo.
APP_ENV=vision-lab
ORBINODO_CLIENT_PROFILE=vision-lab
VITE_ORBINODO_CLIENT_PROFILE=vision-lab
VITE_VISION_SERVICE_URL=http://127.0.0.1:8765
# En Vercel debe ser el endpoint HTTPS estable del nodo remoto.
# Nunca pongas tokens o secretos en variables VITE_*.

# Origins exactos separados por coma. Añade aquí la URL HTTPS exacta de
# OrbiNodo Vision Lab cuando exista; no uses comodines.
VISION_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Pega la URL del proyecto Neon orbinodo-vision-lab-db, nunca la de OrbiNodo Core.
DATABASE_URL=postgresql://usuario:contraseña@ep-tu-host.neon.tech/neondb?sslmode=require

# Solo el hostname de la URL anterior, sin protocolo, usuario, contraseña ni ruta.
VISION_LAB_DATABASE_HOST=ep-tu-host.neon.tech

ORBINODO_API_HOST=127.0.0.1
ORBINODO_API_PORT=3001
ORBINODO_COOKIE_NAME=vision_lab_session
ORBINODO_COOKIE_SECURE=false
ORBINODO_LOG_LEVEL=info

# Local values only, 10 to 128 characters. Never commit real values.
ORBINODO_SEED_PROGRAMMER_PASSWORD=
ORBINODO_SEED_MANAGER_PASSWORD=
ORBINODO_SEED_ENGINEER1_PASSWORD=
ORBINODO_SEED_ENGINEER2_PASSWORD=
