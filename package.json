{
  "name": "recorrido-virtual-vivienda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx watch backend/server.ts",
    "api:start": "tsx backend/server.ts",
    "db:migrate": "tsx backend/database/migrate.ts",
    "db:seed": "tsx backend/database/seed.ts",
    "db:reset": "tsx scripts/reset-local-database.ts",
    "sessions:close": "tsx scripts/close-active-sessions.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json",
    "lint": "eslint src eslint.config.js",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run test && npm run build && npm run verify:browser",
    "test": "vitest run",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vercel": "^58.4.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@photo-sphere-viewer/core": "^5.15.0",
    "@photo-sphere-viewer/markers-plugin": "^5.15.0",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
