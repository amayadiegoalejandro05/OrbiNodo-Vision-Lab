# Orbinodo: acceso técnico al calibrador y al mapa de cámaras.
VITE_DEMO_USERNAME=Orbinodo
VITE_DEMO_PASSWORD_SHA256=pega_aqui_un_hash_sha256_de_64_caracteres

# Jefe: mapa y fichas de solo lectura, historial de accesos y cambios.
VITE_DEMO_MANAGER_USERNAME=Jefe
VITE_DEMO_MANAGER_PASSWORD_SHA256=pega_aqui_otro_hash_sha256_de_64_caracteres

# Ingenieros: mapa y edición limitada de información operativa.
VITE_DEMO_ENGINEER_1_USERNAME=Ingeniero 1
VITE_DEMO_ENGINEER_1_PASSWORD_SHA256=pega_aqui_otro_hash_sha256_de_64_caracteres
VITE_DEMO_ENGINEER_2_USERNAME=Ingeniero 2
VITE_DEMO_ENGINEER_2_PASSWORD_SHA256=pega_aqui_otro_hash_sha256_de_64_caracteres

# Si faltan los hashes de Jefe o Ingenieros, la demo reutiliza temporalmente el
# hash de Orbinodo. Para una presentación formal conviene usar uno diferente.

# API y PostgreSQL locales. El valor de contraseña es deliberadamente falso.
ORBINODO_API_HOST=127.0.0.1
ORBINODO_API_PORT=3001
ORBINODO_DATABASE_HOST=127.0.0.1
ORBINODO_DATABASE_PORT=5432
ORBINODO_DATABASE_NAME=orbinodo_demo
ORBINODO_DATABASE_USER=orbinodo_api
ORBINODO_DATABASE_PASSWORD=ejemplo_no_utilizar
ORBINODO_DATABASE_SSL=false

# Solo db:seed lee estas contraseñas ficticias; la API normal no las necesita.
ORBINODO_SEED_PROGRAMMER_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_MANAGER_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_ENGINEER1_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_ENGINEER2_PASSWORD=ejemplo_falso_de_10_o_mas
