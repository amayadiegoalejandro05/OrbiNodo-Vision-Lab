# API y PostgreSQL locales. El valor de contraseña es deliberadamente falso.
# En Vercel usa DATABASE_URL o POSTGRES_URL inyectada por el proveedor administrado.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
ORBINODO_API_HOST=127.0.0.1
ORBINODO_API_PORT=3001
ORBINODO_TRUSTED_PROXY_HOPS=0
ORBINODO_DATABASE_HOST=127.0.0.1
ORBINODO_DATABASE_PORT=5432
ORBINODO_DATABASE_NAME=orbinodo_demo
ORBINODO_DATABASE_USER=orbinodo_api
ORBINODO_DATABASE_PASSWORD=ejemplo_no_utilizar
ORBINODO_DATABASE_SSL=false
ORBINODO_SESSION_HOURS=8
ORBINODO_SESSION_IDLE_MINUTES=30
ORBINODO_LOGIN_MAX_ATTEMPTS=5
ORBINODO_LOGIN_WINDOW_MINUTES=15
ORBINODO_LOGIN_BLOCK_MINUTES=15
ORBINODO_COOKIE_NAME=orbinodo_session
# false solo para HTTP local; en HTTPS debe ser true.
ORBINODO_COOKIE_SECURE=false

# Solo db:seed lee estas contraseñas ficticias; la API normal no las necesita.
ORBINODO_SEED_PROGRAMMER_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_MANAGER_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_ENGINEER1_PASSWORD=ejemplo_falso_de_10_o_mas
ORBINODO_SEED_ENGINEER2_PASSWORD=ejemplo_falso_de_10_o_mas
